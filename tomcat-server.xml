<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal Tomcat 9 server.xml for a 128 MB / read-only-filesystem container.
  - no shutdown port, no AJP, one HTTP connector on 8080
  - workDir points at /tmp so nothing is written to the read-only root
-->
<Server port="-1" shutdown="SHUTDOWN">
  <Listener className="org.apache.catalina.startup.VersionLoggerListener"/>
  <Service name="Catalina">
    <Connector port="8080"
               protocol="HTTP/1.1"
               address="0.0.0.0"
               connectionTimeout="20000"
               maxThreads="25"
               minSpareThreads="2"
               acceptCount="20"/>
    <Engine name="Catalina" defaultHost="localhost">
      <Host name="localhost"
            appBase="webapps"
            unpackWARs="false"
            autoDeploy="false"
            deployOnStartup="true"
            workDir="/tmp/tomcat/work">
      </Host>
    </Engine>
  </Service>
</Server>
